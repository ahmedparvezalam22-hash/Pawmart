rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products collection: public read and write for catalog management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Blogs collection: public read, write for blog management
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // User profiles & favorites
    match /users/{userId} {
      allow read, write: if true;
      
      // Nested favorites subcollection
      match /favorites/{favoriteId} {
        allow read, write: if true;
      }
    }

    // System settings & admin credentials storage
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Email subscribers collection
    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }
  }
}


